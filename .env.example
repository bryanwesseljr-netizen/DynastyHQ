# Firebase web-client configuration. Vite embeds VITE_ values in the browser bundle,
# so Firebase Security Rules—not secrecy—must protect the database.
VITE_FIREBASE_API_KEY=replace_with_your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=replace_with_your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=replace_with_your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=replace_with_your_firebase_app_id

# Server-only Vercel environment variables. Never prefix these keys with VITE_.
OPENAI_API_KEY=replace_with_your_project_api_key

# Optional. The default is the current flagship alias used for highest accuracy.
OPENAI_VISION_MODEL=gpt-5.6

# Optional. Grounded two-host script generation and text-to-speech defaults.
OPENAI_PODCAST_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional. Verified newsroom article images, with approved references when supplied.
OPENAI_NEWSROOM_IMAGE_MODEL=gpt-image-2

# Required by the authenticated server functions. This normally matches
# VITE_FIREBASE_API_KEY but remains server-scoped for API authentication.
FIREBASE_WEB_API_KEY=replace_with_your_firebase_web_api_key
